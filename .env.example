# ============================================================================
# Enterprise IT Helpdesk Platform - Environment Variables Template
# Copy this file to .env and customize for your Google Cloud deployment.
# ============================================================================

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_API_PREVENT_AGENT_TOKEN_SHARING_FOR_GCP_SERVICES=False

# Optional: Cloud Storage and Telemetry
LOGS_BUCKET_NAME=
SESSION_SERVICE_URI=
